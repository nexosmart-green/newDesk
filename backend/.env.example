APP_NAME=newDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newdesk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: Resend, always via queue (1/s).
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@nexosmart.es"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="desk@nexosmart.es"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# /bug-report — generate with: openssl rand -hex 32
ERRORS_TOKEN=

# monitoring:import — monitoreo's database (read only) and its ENCRYPTION_KEY
MONITOREO_DB_HOST=127.0.0.1
MONITOREO_DB_PORT=3306
MONITOREO_DB_DATABASE=monitoreo
MONITOREO_DB_USERNAME=root
MONITOREO_DB_PASSWORD=
MONITOREO_ENCRYPTION_KEY=

# supervisor:sync
SUPERVISOR_CONF_DIR=/etc/supervisor/conf.d
SUPERVISOR_USER=www-data
